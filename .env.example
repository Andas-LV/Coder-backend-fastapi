PORT=8000
CLIENT_URL=https://your-frontend.example.com
LOCAL_CLIENT_URL=http://localhost:3000
LOCALHOST=http://127.0.0.1:8000
ENVIRONMENT=development

NEXTAUTH_SECRET=

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?ssl=require


OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
LLM_MODEL=gpt-oss:120b

# Embeddings (RAG)
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=auto          # auto | cuda | cpu
CHUNK_SIZE=500             # tokens per chunk
CHUNK_OVERLAP=50

# RAG quality
REWRITE_MODEL=             # model for rewriting follow-up questions; empty = LLM_MODEL
REWRITE_TIMEOUT_S=8        # on timeout the original question is used for search
RAG_MIN_SCORE=0.4          # drop retrieved chunks with cosine similarity below this
HISTORY_MAX_TOKENS=6000    # token budget for chat history sent to the model

# Original PDFs: S3-compatible storage (Cloudflare R2)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com/<bucket>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FILE_URL_TTL_S=3600     # presigned link lifetime, seconds
